{
  "name": "echonext-website",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.18.0",
  "sideEffects": ["*.css"],
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "start": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint",
    "check": "pnpm typecheck && pnpm lint",
    "test": "vitest run",
    "test:watch": "vitest",
    "cf-typegen": "wrangler types",
    "cf-typegen:check": "wrangler types --check",
    "deploy:dry": "pnpm build && wrangler deploy --dry-run",
    "deploy": "pnpm build && wrangler deploy"
  },
  "dependencies": {
    "@tanstack/react-router": "1.170.27",
    "@tanstack/react-start": "1.168.44",
    "cnfast": "^0.1.0",
    "fumadocs-core": "16.15.1",
    "fumadocs-mdx": "15.3.1",
    "fumadocs-ui": "npm:@fumadocs/base-ui@16.15.1",
    "lucide-react": "^1.31.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.22.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/mdx": "^2.0.14",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "oxlint": "^1.78.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vite": "^8.2.1",
    "vitest": "^4.1.0",
    "wrangler": "^4.110.0"
  }
}
